# ── IBM watsonx.ai ─────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── LLM backend (Groq, OpenAI-compatible) ──────────────────────────────────
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
LLM_BACKEND=openai
LLM_TIMEOUT_SECONDS=5

# ── API authentication ─────────────────────────────────────────────────────
# Comma-separated Bearer tokens for the 'infer' role
API_TOKENS=dev-token-1,dev-token-2
# Comma-separated tokens that also receive 'admin' role (subset of API_TOKENS)
ADMIN_TOKENS=

# ── Model & storage paths ──────────────────────────────────────────────────
MODEL_DIR=ml_runs
AUDIT_LOG_DIR=outputs/audit

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
